# Database Configuration
DATABASE_URL=sqlite:///./network_hunter.db
# For production PostgreSQL + pgvector:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/network_hunter

# AI & LLM Services (Configurable Provider)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30.0
EMBEDDING_API_KEY=

# Server Configuration
PROJECT_NAME=Network Hunter API
API_V1_STR=/api/v1
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
